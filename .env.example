# Copy to .env and fill in. Easiest: leave these empty and pick a provider on the
# AI provider page in the app (Settings > AI provider). Keys saved there are encrypted.
ANTHROPIC_API_KEY=

# Free alternatives (any one is enough; the first key found is used):
# GROQ_API_KEY=          # https://console.groq.com/keys
# GEMINI_API_KEY=        # https://aistudio.google.com/apikey
# OPENROUTER_API_KEY=    # https://openrouter.ai/keys
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=
# NVIDIA_API_KEY=
# Or name one explicitly: anthropic, groq, gemini, openrouter, cerebras, mistral,
# nvidia, ollama (local, no key), openai, custom (+ GRC_LLM_BASE_URL, GRC_LLM_API_KEY)
# GRC_AI_PROVIDER=groq

# No API key yet? Uncomment to test every feature with a built-in stand-in for Claude.
# Its answers are placeholders, not AI, and engagements with its findings can't be delivered.
# GRC_AI_MODE=demo

# Optional overrides
# GRC_AGENT_MODEL=claude-opus-5
# GRC_AGENT_EFFORT=high
# GRC_AGENT_MAX_TOKENS=16000
# GRC_AGENT_MAX_TURNS=20

# Database. Leave unset to keep everything in var/grc.db (SQLite).
# For PostgreSQL: pip install -e ".[postgres]", then
# GRC_DATABASE_URL=postgresql://grc:CHANGE-ME@localhost:5432/grc
# Move existing data across once with: grc-web migrate-to-postgres

# HTTPS. Easiest: start with --https (self-signed). Or use your own certificate:
# GRC_TLS_CERT=/path/to/fullchain.pem
# GRC_TLS_KEY=/path/to/privkey.pem
# Behind a reverse proxy that handles HTTPS (Caddy, nginx):
# GRC_TRUSTED_PROXIES=127.0.0.1
# GRC_FORCE_HTTPS=1
# Sites allowed to show the app inside their pages (default: none), for example
# GRC_FRAME_ANCESTORS=https://grc-flow.com https://www.grc-flow.com

# Email (invites and password resets), sent through https://resend.com.
# The sender's domain must be verified in Resend (add its DNS records in Namecheap).
# RESEND_API_KEY=
# GRC_MAIL_FROM=GRC Flow <noreply@grc-flow.com>

# "Continue with Google / Microsoft" on the sign-in page. Register the redirect URI
# https://<your app domain>/auth/google/callback (or /auth/microsoft/callback).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common   # or your tenant id, to allow only your organisation

# Deploying to your own domain (compose.caddy.yaml; see "Deploy to your domain" in the README)
# GRC_DOMAIN=app.grc-flow.com
# GRC_SITE_DOMAIN=grc-flow.com   # also runs the website (compose.site.yaml)
# GRC_DEPLOY_BRANCHES=all   # setup-server.sh merges these branches on top of main (or a list)
# GRC_SITE_URL=https://grc-flow.com   # the app's sign-in page links here (compose.site.yaml sets it)
# POSTGRES_PASSWORD=<a long random password>
