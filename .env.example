# Copy to .env and fill in. Alternatively run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=

# No API key yet? Uncomment to test every feature with a built-in stand-in for Claude.
# Its answers are placeholders, not AI, and engagements with its findings can't be delivered.
# GRC_AI_MODE=demo

# Optional overrides
# GRC_AGENT_MODEL=claude-opus-5
# GRC_AGENT_EFFORT=high
# GRC_AGENT_MAX_TOKENS=16000
# GRC_AGENT_MAX_TURNS=20

# Database. Leave unset to keep everything in var/grc.db (SQLite).
# For PostgreSQL: pip install -e ".[postgres]", then
# GRC_DATABASE_URL=postgresql://grc:CHANGE-ME@localhost:5432/grc
# Move existing data across once with: grc-web migrate-to-postgres
