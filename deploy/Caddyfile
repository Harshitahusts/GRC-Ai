# Caddy is the only thing on this server that faces the internet. It gets and renews free
# Let's Encrypt certificates by itself and sends each address to the right place:
#
#   app.grc-flow.com           -> the GRC Flow app (container "web")
#   grc-flow.com, www.         -> the website (container "website", compose.site.yaml)
#
# The addresses come from .env (GRC_DOMAIN, GRC_SITE_DOMAIN); see compose.caddy.yaml and
# compose.site.yaml. The app sets its own security headers; Caddy adds them for the website.

{$GRC_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:8000
	header {
		-Server
	}
}

# The website. Without compose.site.yaml this block listens on a local-only address that
# never asks for a certificate, so a server that hosts only the app needs no extra DNS.
{$GRC_SITE_ADDRESS} {
	encode zstd gzip
	# www.grc-flow.com -> grc-flow.com, keeping the page.
	@www expression {host}.startsWith("www.")
	redir @www https://{http.request.host.labels.1}.{http.request.host.labels.0}{uri} 308
	reverse_proxy website:3000
	# Pages: browsers check for a new version on every visit, so an update shows on a
	# normal reload (no Ctrl+F5). Files under /_next/static/ have the version in their name
	# and keep the long cache the website gives them.
	@pages not path /_next/static/*
	header @pages >Cache-Control "no-cache"
	header {
		-Server
		-X-Powered-By
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}
}
